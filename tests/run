#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${TMPDIR:-/tmp}/sportsbar-cargo-target}"
python3 "$root/scripts/validate_manifest.py" "$root"
node --test "$root/tests/"*.test.cjs
cargo test --locked --manifest-path "$root/Cargo.toml"
cargo fmt --check --manifest-path "$root/Cargo.toml"
if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$root"
fi
printf 'Portable checks passed; see docs/VERIFICATION.md for live-test limits.\n'
